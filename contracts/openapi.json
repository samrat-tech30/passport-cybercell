  "components": {
    "schemas": {
      "ApprovalIn": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "ApprovalIn"
      },
      "ContextItem": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "trust": {
            "type": "string",
            "enum": [
              "trusted",
              "untrusted",
              "secret"
            ],
            "title": "Trust"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "trust",
          "text"
        ],
        "title": "ContextItem"
      },
      "DecideIn": {
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "user_request": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "User Request"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "args",
          "user_request"
        ],
        "title": "DecideIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewSessionIn": {
        "properties": {
          "scenario_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "user_request": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "User Request"
          },
          "shield_on": {
            "type": "boolean",
            "title": "Shield On",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "replay",
              "live"
            ],
            "title": "Mode",
            "default": "replay"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewSessionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
