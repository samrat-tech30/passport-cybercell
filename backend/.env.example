# Backend settings. Copy to backend/.env for local runs (never commit .env).
# Every variable is validated in app/config.py; the app refuses to start on a bad value.

APP_ENV=dev                          # dev | test | prod
DATA_DIR=./var                       # where passport.db (SQLite) lives
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # the frontend URL(s), comma separated. Never "*".

# Optional: if set, POST endpoints need header X-Demo-Code (protects a public demo URL).
DEMO_ACCESS_CODE=

# Optional: live LLM mode (any OpenAI-compatible API: Groq, OpenRouter, Ollama, OpenAI...).
# Replay mode needs none of these. Check the provider's docs for the exact base URL and model name.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
ALLOW_LIVE_LLM=true                  # defaults to false when APP_ENV=prod

APPROVAL_TIMEOUT_S=120               # no answer = DENY (fail closed)
MAX_AGENT_STEPS=8
RATE_LIMIT_PER_MIN=30
MAX_BODY_BYTES=64000
